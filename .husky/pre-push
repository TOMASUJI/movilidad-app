# Bloquea los push directos a main y a las ramas de iteración (it-NN).
# Crear la rama por primera vez sí está permitido; después, solo se actualizan mediante PR.
ZERO=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/it-[0-9][0-9])
      if [ "$remote_sha" != "$ZERO" ] && [ "$local_sha" != "$ZERO" ]; then
        echo ""
        echo "✖ No se puede hacer push directo a ${remote_ref#refs/heads/}."
        echo "  Trabaja en una rama de historia (npm run historia -- XX) y abre una pull request."
        echo ""
        exit 1
      fi
      ;;
  esac
done
exit 0
