# Plantilla del .env de la API. Cópiala:  copy apps\api\.env.example apps\api\.env
# y ajusta las direcciones a tu PostgreSQL. El .env NUNCA se sube a GitHub.

# Base de datos de desarrollo (la que usa la API al arrancar)
#   Con Docker (docker compose up -d):  puerto 5433
#   Con PostgreSQL instalado en Windows: normalmente puerto 5432
DATABASE_URL="postgresql://movilidad:movilidad@localhost:5433/movilidad"

# Base de datos de pruebas (la que vacían y rellenan las pruebas de integración y aceptación)
#   Con PostgreSQL instalado: crea la base de datos movilidad_test y descomenta la línea.
#   Con Docker: déjala comentada y Testcontainers creará una base de datos temporal en cada ejecución.
# TEST_DATABASE_URL="postgresql://movilidad:movilidad@localhost:5432/movilidad_test"

# Openrouteservice (no se usa en la iteración 1)
ORS_API_KEY=""
ORS_BASE_URL="https://api.heigit.org/openrouteservice"
